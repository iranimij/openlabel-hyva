<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="openlabel_listing_slot" type="Iranimij\OpenLabelHyva\Plugin\ProductImagePlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\View\Gallery">
        <plugin name="openlabel_gallery_slot" type="Iranimij\OpenLabelHyva\Plugin\GalleryPlugin"/>
    </type>
    <!-- 1.1: labels in the product text (next to the price, next to Add to Cart, under the name). -->
    <type name="Magento\Framework\View\Layout">
        <plugin name="openlabel_inline_slots" type="Iranimij\OpenLabelHyva\Plugin\InlineSlotPlugin"/>
    </type>
    <type name="Iranimij\OpenLabelHyva\Plugin\InlineSlotPlugin">
        <arguments>
            <argument name="productPageSlots" xsi:type="array">
                <item name="product.info.title" xsi:type="string">under_name</item>
                <item name="product.info.price" xsi:type="string">near_price</item>
                <item name="product.info.addtocart" xsi:type="string">near_cart</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Pricing\Render\FinalPriceBox">
        <plugin name="openlabel_near_price" type="Iranimij\OpenLabelHyva\Plugin\PriceBoxPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\View">
        <plugin name="openlabel_list_item_slots" type="Iranimij\OpenLabelHyva\Plugin\ListItemPlugin"/>
    </type>
    <!-- 1.1: labels in the cart, mini cart, wish list and compare list. -->
    <type name="Magento\Checkout\Block\Cart\Item\Renderer">
        <plugin name="openlabel_cart_item" type="Iranimij\OpenLabelHyva\Plugin\Items\CartItemPlugin"/>
    </type>
    <type name="Magento\Checkout\CustomerData\AbstractItem">
        <plugin name="openlabel_minicart_item" type="Iranimij\OpenLabelHyva\Plugin\Items\MiniCartItemPlugin"/>
    </type>
    <!-- After the Tax/Weee plugins, which render every item's product_price again. -->
    <type name="Magento\Checkout\CustomerData\Cart">
        <plugin name="openlabel_minicart_section" type="Iranimij\OpenLabelHyva\Plugin\Items\MiniCartItemPlugin" sortOrder="1000"/>
    </type>
    <type name="Magento\Wishlist\Block\Customer\Wishlist\Item\Column\Info">
        <plugin name="openlabel_wishlist_item" type="Iranimij\OpenLabelHyva\Plugin\Items\WishlistItemPlugin"/>
    </type>
    <type name="Magento\Catalog\Block\Product\Compare\ListCompare">
        <plugin name="openlabel_compare_list" type="Iranimij\OpenLabelHyva\Plugin\Items\CompareListPlugin"/>
    </type>
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="openlabel_remember_products" type="Iranimij\OpenLabelHyva\Plugin\CollectionPreloadPlugin"/>
    </type>
</config>
