<!-- Every Hyvä page: the single generated stylesheet and the page cache tags of rendered labels. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Iranimij\OpenLabel\Block\Css" name="openlabel.css"/>
        </referenceBlock>
        <referenceContainer name="before.body.end">
            <block class="Iranimij\OpenLabel\Block\Identities" name="openlabel.identities"/>
            <block class="Iranimij\OpenLabelHyva\Block\Script" name="openlabel.script"
                   template="Iranimij_OpenLabelHyva::js/labels.phtml" after="openlabel.identities"/>
        </referenceContainer>
    </body>
</page>
